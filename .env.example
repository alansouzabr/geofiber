# ============================================================
# GeoFiber Maps — exemplo de ambiente
# NUNCA coloque credenciais reais neste arquivo.
# ============================================================

NODE_ENV=production

# Aplicacao
API_PORT=3001
PORTAL_PORT=3000

# PostgreSQL / PostGIS
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=geofiber
DB_USER=geofiber
DB_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql://geofiber:CHANGE_ME@127.0.0.1:5432/geofiber?schema=public

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# URL publica da API usada pelo Portal
NEXT_PUBLIC_API_URL=https://api.example.com

# Uploads
UPLOAD_MAX_SIZE_GED=52428800
UPLOAD_MAX_SIZE_TRAINING=52428800

# Stripe
STRIPE_SECRET_KEY=

# Nginx / dominios
DOMAIN=example.com
PANEL_DOMAIN=painel.example.com
API_DOMAIN=api.example.com
