{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "downlevelIteration": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "backups",
    "backup",
    "**/*.bak",
    "**/*.backup",
    "**/BKP-*",
    "BKP-*",
    "**/*-BKP-*",
    "**/GEOFIBER-SAFE-*",
    "**/*.BKP-*",
    "**/*.BACKUP-*",
    "**/*.bak-*",
    "**/*.backup-*",
    "**/BACKUP-*",
    "**/backup-patch-*"
  ]
}
